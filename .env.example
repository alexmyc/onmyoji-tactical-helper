# ==============================================================================
# Onmyoji Tactical Helper — Optional Cloud Sync & License Configuration Template
# ==============================================================================
# Copy this file to `.env` ONLY if you want to connect your own private Google
# Sheets playbooks and hardware license table.
#
# When `.env` is absent (default after `git clone`), the application seamlessly
# runs in Public Sandbox Mode using built-in sample playbooks and 25+ meta
# shikigami combat profiles — try `python run_app.py --demo` right away!
# ==============================================================================

ONMYOJI_AUTH_CSV_URL=
ONMYOJI_SHEET_DICT_MAP=
ONMYOJI_SHEET_DB_EXPORT=
ONMYOJI_SHEET_MULTI_SHORTS=
ONMYOJI_SHEET_SHIKIGAMI_TAGS=
ONMYOJI_SHEET_VERSION_CTRL=
